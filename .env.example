# DB接続（本番はDocker Composeのpostgresサービスを指す）
# ローカルでDockerを使わずに試す場合は `npx prisma dev` でローカルPostgresを起動し、
# 表示された接続文字列に pgbouncer=true&connection_limit=5 を付与して使う。
# connection_limitは必ず5程度に抑えること（prisma devのプロキシは同時接続数が
# 実質10前後までしか捌けず、デフォルトのプールサイズ（CPUコア数依存で10を超えがち）
# のままだと「Can't reach database server」が頻発する）。
DATABASE_URL="postgresql://user:password@localhost:5432/aaw_admin?schema=public"

# セッション署名鍵（openssl rand -base64 32 で生成）
AUTH_SECRET=
# TOTPシークレット暗号化鍵。base64の32バイト（openssl rand -base64 32 で生成）
ADMIN_TOTP_ENCRYPTION_KEY=

# セッション・ログイン試行制限（単位: 時間/分/回）
ADMIN_SESSION_MAX_AGE_HOURS=4
ADMIN_IDLE_TIMEOUT_MINUTES=20
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15

# 開発環境のシード投入時のみ使用（本番では設定しないこと）
DEV_SEED_ADMIN_PASSWORD=

# 通知先（要確認事項の自動通知・テスト送信で使用。未設定ならその通知手段は無効になる）
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# 通常の外部SMTPは認証必須。認証不要の内部リレーを使う場合だけfalse
SMTP_AUTH_REQUIRED=true

# Stripe（サービスごとの読み取り専用キーを設定する。管理サイトからの返金・送金操作は行わない）
STRIPE_SECRET_KEY=

# PayPal（読み取り専用。REST APIのクライアントID/シークレットを使う）
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI売上戦略アドバイス（未設定の場合、売上画面のAI分析は「未設定」表示になる）
ANTHROPIC_API_KEY=
